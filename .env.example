# Copy this file to .env and fill in real values.
# MongoDB connection string; the database name in the URI is used by the app.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>
# Secret used to sign JWTs — use a long random string in production.
JWT_SECRET=change-me
# Optional overrides:
# JWT_EXPIRY_DAYS=7
# CORS_ORIGINS=*
